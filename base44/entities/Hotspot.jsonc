{
  "name": "Hotspot",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "center_lat": {
      "type": "number"
    },
    "center_lng": {
      "type": "number"
    },
    "radius_meters": {
      "type": "number",
      "default": 200
    },
    "risk_score": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "moderate",
        "elevated",
        "high",
        "very_high"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "insufficient",
        "low",
        "moderate",
        "high"
      ]
    },
    "report_count": {
      "type": "integer"
    },
    "verified_report_count": {
      "type": "integer"
    },
    "dominant_incident_type": {
      "type": "string"
    },
    "severity_distribution": {
      "type": "object"
    },
    "time_pattern": {
      "type": "string"
    },
    "group_presence_count": {
      "type": "integer"
    },
    "nearby_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_window_days": {
      "type": "integer",
      "default": 30
    },
    "ward": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "last_calculated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "center_lat",
    "center_lng",
    "risk_level",
    "report_count"
  ]
}