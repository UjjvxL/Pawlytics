{
  "name": "Verification",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "duplicate",
        "needs_review"
      ]
    },
    "reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "report_id",
    "decision"
  ]
}