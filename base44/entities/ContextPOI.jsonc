{
  "name": "ContextPOI",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "poi_type": {
      "type": "string",
      "enum": [
        "school",
        "hospital",
        "park",
        "waste_site",
        "road",
        "arv_facility",
        "feeding_zone",
        "market"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "ward": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": "Bengaluru"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "poi_type",
    "latitude",
    "longitude"
  ]
}