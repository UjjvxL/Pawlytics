{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "new_hotspot",
        "risk_elevated",
        "bite_reported",
        "authority_action",
        "system"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "ward": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "target_role": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "message",
    "alert_type",
    "severity"
  ]
}