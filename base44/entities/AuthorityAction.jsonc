{
  "name": "AuthorityAction",
  "type": "object",
  "properties": {
    "hotspot_id": {
      "type": "string"
    },
    "ward_id": {
      "type": "string"
    },
    "authority_id": {
      "type": "string"
    },
    "authority_name": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "field_inspection_scheduled",
        "abc_team_notified",
        "waste_issue_reported",
        "area_inspection_completed",
        "public_warning_issued",
        "feeding_zone_review",
        "sterilization_drive_scheduled",
        "vaccination_drive_scheduled",
        "other"
      ]
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "location_label": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "action_type",
    "status"
  ]
}